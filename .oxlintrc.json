{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "vue"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "warn",
    "no-console": [
      "warn",
      {
        "allow": ["info", "warn", "error"]
      }
    ]
  },
  "env": {
    "builtin": true,
    "browser": true
  }
}
